# 复制为 /etc/vd-relay.env，chmod 600。以下全部是示例占位符，必须换成你自己生成的随机值。
# 生成：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
RELAY_UPLOAD_TOKEN=请替换为随机长字符串A
RELAY_SIGNING_KEY=请替换为随机长字符串B
# 朋友打开的网站地址（Funnel 网址），多个用英文逗号分隔，不要带结尾斜杠
RELAY_ALLOWED_ORIGIN=https://你的电脑名.你的tailnet.ts.net
RELAY_DATA=/var/lib/vd-relay
RELAY_RETENTION_DAYS=7
